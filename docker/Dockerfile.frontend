# Stage 1: Build the React application
FROM node:24-alpine AS builder
WORKDIR /app

# Declare ARGs that Coolify may pass (prevents auto-injection of 60+ ARGs)
# These are NOT used in the build - they're runtime config - but declaring them
# prevents Coolify from injecting them automatically
ARG SPARKY_FITNESS_FRONTEND_URL
ARG SPARKY_FITNESS_DB_NAME
ARG SPARKY_FITNESS_DB_USER
ARG SPARKY_FITNESS_DB_PASSWORD
ARG SPARKY_FITNESS_APP_DB_USER
ARG SPARKY_FITNESS_APP_DB_PASSWORD
ARG SPARKY_FITNESS_API_ENCRYPTION_KEY
ARG BETTER_AUTH_SECRET
ARG SPARKY_FITNESS_ADMIN_EMAIL
ARG SPARKY_FITNESS_DISABLE_SIGNUP
ARG SPARKY_FITNESS_FORCE_EMAIL_LOGIN
ARG SPARKY_FITNESS_PUBLIC_API_DOCS
ARG DEV_TOOLS_ENABLED
ARG ALLOW_PRIVATE_NETWORK_CORS
ARG ALLOW_PRIVATE_NETWORK_AI
ARG SPARKY_FITNESS_LOG_LEVEL
ARG TZ
ARG GARMIN_MICROSERVICE_URL
ARG GARMIN_SERVICE_PORT
ARG GARMIN_SERVICE_IS_CN
ARG NGINX_RATE_LIMIT
ARG NODE_ENV
ARG COOLIFY_FQDN
ARG SERVICE_FQDN_SPARKYFITNESS_FRONTEND_8080
# Additional ARGs that Coolify may pass (legacy/unused but need declaration)
ARG DB_PATH
ARG SERVER_BACKUP_PATH
ARG SERVER_UPLOADS_PATH
ARG SPARKY_FITNESS_FRONTEND_PORT
ARG SPARKY_FITNESS_EXTRA_TRUSTED_ORIGINS
ARG NGINX_LISTEN_PORT
ARG NGINX_DUMP_CONFIG

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

# Copy global lockfile
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all workspace member package.json files for dependency graph resolution
COPY SparkyFitnessServer/package.json ./SparkyFitnessServer/
COPY SparkyFitnessFrontend/package.json ./SparkyFitnessFrontend/
COPY SparkyFitnessMobile/package.json ./SparkyFitnessMobile/
COPY shared/package.json ./shared/

# Copy patch files referenced by pnpm.patchedDependencies in root package.json
COPY patches/ ./patches/

# Coolify may inject NODE_ENV=production as a build ARG/ENV (skips devDependencies).
# Vite/TypeScript live in devDependencies — force a full install for the builder stage.
RUN NODE_ENV=development pnpm install --frozen-lockfile --prod=false --filter sparkyfitnessfrontend...

# Copy the frontend and shared source code
COPY SparkyFitnessFrontend/ ./SparkyFitnessFrontend/
COPY shared/ ./shared/

# Build the application (skip validation - that belongs in CI, not Docker build)
# Call vite directly instead of 'pnpm run build' which includes typecheck/lint/prettier
WORKDIR /app/SparkyFitnessFrontend
RUN NODE_ENV=production pnpm exec vite build

# Stage 2: Serve the application with Nginx
FROM nginx:alpine3.22

# Install bash for console access, gettext for envsubst, and curl for healthcheck
RUN apk add --no-cache bash gettext curl

# Copy the build output from the builder stage
COPY --from=builder /app/SparkyFitnessFrontend/dist /usr/share/nginx/html

# Copy the nginx configuration template
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

# Copy and set up the entrypoint script
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh \
    && mkdir -p /var/run/nginx /var/cache/nginx /etc/nginx/conf.d /var/log/nginx \
    && chgrp -R 0 /var/run/nginx /var/cache/nginx /etc/nginx/conf.d /var/log/nginx \
    && chmod -R g+wX /var/run/nginx /var/cache/nginx /etc/nginx/conf.d /var/log/nginx \
    && sed -i 's|/var/run/nginx.pid|/var/run/nginx/nginx.pid|g' /etc/nginx/nginx.conf \
    && sed -i 's|^[[:space:]]*user|#user|g' /etc/nginx/nginx.conf

# Set default values for environment variables
ENV SPARKY_FITNESS_SERVER_HOST=sparkyfitness-server
ENV SPARKY_FITNESS_SERVER_PORT=3010
ENV NGINX_RATE_LIMIT=5r/s

# Expose port 80
EXPOSE 80

# Healthcheck (checks the dynamically configured port, falling back to 80 for root and 8080 for non-root)
HEALTHCHECK --interval=5s --timeout=10s --retries=5 CMD curl -f http://127.0.0.1:${NGINX_LISTEN_PORT:-$([ "$(id -u)" -eq 0 ] && echo 80 || echo 8080)}

# Start with our custom entrypoint
CMD ["/docker-entrypoint.sh"]
