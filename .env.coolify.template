# =============================================================================
# SparkyFitness Coolify Environment Variables Template
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to create your actual .env.coolify (DO NOT commit the real one)
# 2. Replace all CHANGE_ME values with your actual secrets/settings
# 3. Generate secrets using: openssl rand -hex 32
# 4. Paste these variables into Coolify's Environment Variables UI
# 5. Do NOT add SERVICE_URL_* or SERVICE_FQDN_* variables (Coolify injects those)
#
# Compose file: docker/docker-compose.coolify.yml
# Deployment guide: docker/coolify_deployments.md
# Troubleshooting: docker/COOLIFY_DEPLOYMENT_FIXES.md
#
# =============================================================================

# =============================================================================
# DATABASE - PostgreSQL Connection (REQUIRED)
# =============================================================================
# These credentials are used by both the PostgreSQL container and the backend server.
# IMPORTANT: Choose strong passwords and NEVER change these after initial deployment
# (changing them will break access to existing data).

SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# App-level database user (less privileged than superuser)
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32


# =============================================================================
# SECURITY SECRETS (REQUIRED)
# =============================================================================
# Generate each secret with: openssl rand -hex 32
# 
# CRITICAL WARNINGS:
# - NEVER change SPARKY_FITNESS_API_ENCRYPTION_KEY after deployment
#   (changing it will invalidate all encrypted third-party provider data)
# - NEVER change BETTER_AUTH_SECRET after users enable TOTP/2FA
#   (changing it will lock out all users who have 2FA enabled)

# 64-character hex string for encrypting provider credentials (Garmin, etc.)
SPARKY_FITNESS_API_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# 64-character hex string for session signing and TOTP secret encryption
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32


# =============================================================================
# PUBLIC URL & ROUTING (REQUIRED)
# =============================================================================
# Must EXACTLY match the domain you assign to sparkyfitness-frontend in Coolify.
# Format: https://your-domain.com (no trailing slash)
# This is used for CORS, auth callbacks, and generating links.

SPARKY_FITNESS_FRONTEND_URL=https://fitness.lopez-coll.com


# =============================================================================
# APPLICATION SETTINGS (REQUIRED)
# =============================================================================

# Admin user email address (used for initial admin account and notifications)
SPARKY_FITNESS_ADMIN_EMAIL=your-email@example.com

# Disable new user signups (set to true after creating your admin account)
# Values: true | false
SPARKY_FITNESS_DISABLE_SIGNUP=false

# Force email login (disable username login)
# Values: true | false
SPARKY_FITNESS_FORCE_EMAIL_LOGIN=true

# Enable public API documentation at /api/docs
# Values: true | false
SPARKY_FITNESS_PUBLIC_API_DOCS=false

# Enable development tools (React Query devtools, etc.)
# Values: true | false
DEV_TOOLS_ENABLED=false

# Application logging level
# Values: ERROR | WARN | INFO | DEBUG
SPARKY_FITNESS_LOG_LEVEL=ERROR

# Server timezone (affects day boundaries for daily stats)
# Examples: America/New_York, America/Denver, Europe/London, UTC
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Denver


# =============================================================================
# NETWORK & CORS (RECOMMENDED FOR SELF-HOSTING)
# =============================================================================

# Allow CORS from private network IPs (192.168.x.x, 10.x.x.x, etc.)
# Set to true if you access the app via LAN IP addresses
# Values: true | false
ALLOW_PRIVATE_NETWORK_CORS=true

# Allow AI features to access private network URLs
# SECURITY WARNING: Only enable on trusted single-tenant setups
# Values: true | false
ALLOW_PRIVATE_NETWORK_AI=false


# =============================================================================
# GARMIN INTEGRATION (OPTIONAL - uses defaults if not set)
# =============================================================================
# These configure the Garmin microservice connection.
# Defaults work for standard docker-compose.coolify.yml setup.

# Internal URL for Garmin microservice (docker network hostname)
GARMIN_MICROSERVICE_URL=http://sparkyfitness-garmin:8000

# Port the Garmin service listens on
GARMIN_SERVICE_PORT=8000

# Set to true only if you're in China and need to use Garmin CN servers
# Values: true | false
GARMIN_SERVICE_IS_CN=false


# =============================================================================
# NGINX / FRONTEND (OPTIONAL - uses defaults if not set)
# =============================================================================

# Rate limiting for API requests (requests per second)
# Format: Xr/s where X is number of requests
# Examples: 5r/s, 10r/s, 20r/s
NGINX_RATE_LIMIT=5r/s


# =============================================================================
# NOTES
# =============================================================================
#
# Variables NOT needed (Coolify handles these):
# - SERVICE_URL_* (auto-injected by Coolify, cannot be deleted)
# - SERVICE_FQDN_* (auto-injected by Coolify, cannot be deleted)
# - NODE_ENV (set in Dockerfiles, not needed in environment)
# - DB_PATH, SERVER_BACKUP_PATH, SERVER_UPLOADS_PATH (uses named volumes instead)
# - SPARKY_FITNESS_DB_HOST (hardcoded to sparkyfitness-db in compose)
# - SPARKY_FITNESS_DB_PORT (hardcoded to 5432 in compose)
# - SPARKY_FITNESS_SERVER_HOST (hardcoded in nginx config)
# - SPARKY_FITNESS_SERVER_PORT (hardcoded to 3010 in compose)
#
# How to generate secrets:
#   openssl rand -hex 32
#
# Or use this one-liner to generate all secrets:
#   echo "SPARKY_FITNESS_DB_PASSWORD=$(openssl rand -hex 32)"
#   echo "SPARKY_FITNESS_APP_DB_PASSWORD=$(openssl rand -hex 32)"
#   echo "SPARKY_FITNESS_API_ENCRYPTION_KEY=$(openssl rand -hex 32)"
#   echo "BETTER_AUTH_SECRET=$(openssl rand -hex 32)"
#
# =============================================================================
